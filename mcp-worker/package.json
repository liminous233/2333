{
  "name": "case0110-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "check-content": "node scripts/sync-content.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run check-content && node --import tsx --test test/*.test.ts",
    "dev": "wrangler dev",
    "build": "wrangler deploy --env preview --dry-run --outdir dist",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy": "wrangler deploy --env production"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
