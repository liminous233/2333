{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "case0110-mcp-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "ENDING_DB",
      "database_name": "case0110-mcp-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "case0110-mcp-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "ENDING_DB",
          "database_name": "case0110-mcp-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "case0110-mcp",
      "workers_dev": true,
      "triggers": { "crons": ["17 3 * * *"] },
      "d1_databases": [
        {
          "binding": "ENDING_DB",
          "database_name": "choir-ending-stats",
          "database_id": "3347f608-afd0-4c01-8314-55a51948698b",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
